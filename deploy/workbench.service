[Unit]
Description=YuE2-Workbench (FastAPI + static SPA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=feifei
WorkingDirectory=/home/feifei/develop/app/YuE2-Workbench
ExecStart=/home/feifei/develop/app/YuE2-Workbench/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend
Restart=on-failure
RestartSec=3
# the app loads .env itself; keep env minimal here

[Install]
WantedBy=multi-user.target
